{
  "appId": "com.kiidfromdream.pos",
  "productName": "KIID FROM DREAM POS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "data/pos_database.json",
    "!data/*.db*",
    "!data/*.sqlite*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "data",
      "to": "data",
      "filter": ["*.json"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "KIID FROM DREAM POS"
  }
}
